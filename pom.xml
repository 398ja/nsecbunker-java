<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>xyz.tcheeric</groupId>
    <artifactId>nsecbunker-java</artifactId>
    <version>0.1.1</version>
    <packaging>pom</packaging>

    <name>nsecBunker Java Library</name>
    <description>Java client library for interacting with nsecBunker - NIP-46 remote key signing</description>
    <url>https://github.com/cashutools/nsecbunker-java</url>

    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/licenses/MIT</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <developers>
        <developer>
            <name>Eric</name>
            <organization>398ja</organization>
        </developer>
    </developers>

    <scm>
        <connection>scm:git:git://github.com/398ja/nsecbunker-java.git</connection>
        <developerConnection>scm:git:ssh://github.com:398ja/nsecbunker-java.git</developerConnection>
        <url>https://github.com/398ja/nsecbunker-java/tree/main</url>
    </scm>

    <modules>
        <module>nsecbunker-core</module>
        <module>nsecbunker-connection</module>
        <module>nsecbunker-protocol</module>
        <module>nsecbunker-admin</module>
        <module>nsecbunker-client</module>
        <module>nsecbunker-monitoring</module>
        <module>nsecbunker-account</module>
        <module>nsecbunker-spring-boot-starter</module>
        <module>nsecbunker-tests</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <java.version>21</java.version>

        <!-- Dependency versions -->
        <nostr-java.version>1.2.0</nostr-java.version>
        <jackson.version>2.17.0</jackson.version>
        <okhttp.version>4.12.0</okhttp.version>
        <slf4j.version>2.0.12</slf4j.version>
        <logback.version>1.5.15</logback.version>
        <junit.version>5.12.2</junit.version>
        <mockito.version>5.11.0</mockito.version>
        <assertj.version>3.25.3</assertj.version>
        <awaitility.version>4.2.1</awaitility.version>
        <testcontainers.version>1.19.7</testcontainers.version>
        <lombok.version>1.18.32</lombok.version>
        <micrometer.version>1.14.3</micrometer.version>
        <spring-boot.version>3.5.9</spring-boot.version>
        <maven.javadoc.skip>true</maven.javadoc.skip>

        <!-- Plugin versions -->
        <maven-compiler-plugin.version>3.13.0</maven-compiler-plugin.version>
        <maven-surefire-plugin.version>3.2.5</maven-surefire-plugin.version>
        <maven-failsafe-plugin.version>3.2.5</maven-failsafe-plugin.version>
        <maven-jar-plugin.version>3.3.0</maven-jar-plugin.version>
        <maven-resources-plugin.version>3.3.1</maven-resources-plugin.version>
        <maven-source-plugin.version>3.3.0</maven-source-plugin.version>
        <maven-javadoc-plugin.version>3.6.3</maven-javadoc-plugin.version>
        <maven-gpg-plugin.version>3.2.2</maven-gpg-plugin.version>
        <maven-deploy-plugin.version>3.1.1</maven-deploy-plugin.version>
        <maven-install-plugin.version>3.1.1</maven-install-plugin.version>
        <flatten-maven-plugin.version>1.6.0</flatten-maven-plugin.version>
        <jacoco-maven-plugin.version>0.8.11</jacoco-maven-plugin.version>
        <checkstyle.version>10.14.2</checkstyle.version>
        <maven-checkstyle-plugin.version>3.3.1</maven-checkstyle-plugin.version>
        <spotbugs-maven-plugin.version>4.8.3.1</spotbugs-maven-plugin.version>
        <maven-pmd-plugin.version>3.26.0</maven-pmd-plugin.version>
        <jmh.version>1.37</jmh.version>
        <dependency-check-maven.version>9.0.9</dependency-check-maven.version>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- Internal modules -->
            <dependency>
                <groupId>xyz.tcheeric</groupId>
                <artifactId>nsecbunker-core</artifactId>
